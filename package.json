{
  "name": "baron-builders",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/checks/run-all.mjs",
    "check:layering": "node scripts/checks/layering.mjs",
    "check:forbidden": "node scripts/checks/forbidden.mjs",
    "check:routes": "node scripts/checks/routes.mjs",
    "check:service-role": "node scripts/checks/service-role.mjs",
    "check:list-pagination": "node scripts/checks/list-pagination.mjs",
    "check:spelling": "node scripts/checks/spelling.mjs",
    "check:ci": "npm run check && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  }
}
